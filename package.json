{
  "name": "obsidian-local-voiceover",
  "version": "1.1.1",
  "description": "Desktop Obsidian plugin for local Inflect Micro v2 voiceover",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production && tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "check:markdown": "markdownlint-cli2 '**/*.md'",
    "check:unused": "knip",
    "check:cycles": "madge --circular --extensions ts,mjs --ts-config tsconfig.json main.ts",
    "check:duplicates": "jscpd",
    "check": "npm run build && npm run lint && npm run check:markdown && npm run check:unused && npm run check:cycles && npm run check:duplicates",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.38.6",
    "ephone": "1.0.2",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.59.0",
    "esbuild": "0.17.3",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.2.4",
    "jscpd": "^4.2.5",
    "knip": "^5.88.1",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.18.1",
    "obsidian": "latest",
    "typescript": "^5.9.3"
  }
}
